---
/**
 * Icones desenhados em linha, sem biblioteca externa e sem requisicao extra.
 * Sao decorativos: quem precisa de rotulo usa texto ao lado, nunca so a forma
 * (item 42 — cor e forma nunca sao o unico canal de informacao).
 */
export type NomeDoIcone =
  | 'whatsapp'
  | 'telefone'
  | 'email'
  | 'instagram'
  | 'local'
  | 'relogio'
  | 'seta'
  | 'folha'
  | 'agulha'
  | 'mente'
  | 'movimento'
  | 'coracao'
  | 'equilibrio'
  | 'maos'
  | 'grupo';

interface Props {
  nome: NomeDoIcone;
  tamanho?: number;
  class?: string;
}

const { nome, tamanho = 24, class: classe } = Astro.props;
---

<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nome === 'whatsapp' && (
      <>
        <path d="M3.5 20.5 4.8 16.6A8.2 8.2 0 1 1 8 19.4l-4.5 1.1Z" />
        <path d="M9 9.2c.3 1 .8 1.9 1.5 2.6.7.7 1.6 1.2 2.6 1.5l.9-1.1 1.9.9c-.2.9-1 1.5-1.9 1.4a7.2 7.2 0 0 1-5.7-5.7c-.1-.9.5-1.7 1.4-1.9l.9 1.9-.9.9Z" />
      </>
    )
  }
  {
    nome === 'telefone' && (
      <path d="M6.5 3.5h3l1.5 4-2 1.4a11 11 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
    )
  }
  {
    nome === 'email' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
        <path d="m3.5 7 8.5 6 8.5-6" />
      </>
    )
  }
  {
    nome === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    nome === 'local' && (
      <>
        <path d="M12 21.5s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
        <circle cx="12" cy="10.2" r="2.6" />
      </>
    )
  }
  {
    nome === 'relogio' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.2V12l3.2 1.9" />
      </>
    )
  }
  {nome === 'seta' && <path d="M5 12h13m-5.5-5.5L18 12l-5.5 5.5" />}
  {
    nome === 'folha' && (
      <>
        <path d="M20 4c0 8-4.6 12.5-11 12.5H5.5C5.5 9 10.5 4 20 4Z" />
        <path d="M4 20c2.5-4 5.5-6.5 9-8" />
      </>
    )
  }
  {
    nome === 'agulha' && (
      <>
        <path d="M4 20 20 4M8 20 20 8M4 16 16 4" />
        <circle cx="20" cy="4" r="0" />
      </>
    )
  }
  {
    nome === 'mente' && (
      <>
        <path d="M15.5 20v-2.6a5.5 5.5 0 0 0 3.2-8.9A6 6 0 0 0 7.2 6.6 4.4 4.4 0 0 0 6 15.1h2.5V20" />
        <path d="M12 10.5a1.6 1.6 0 1 0 0-.1" />
      </>
    )
  }
  {
    nome === 'movimento' && (
      <>
        <path d="M20 12a8 8 0 1 1-2.4-5.7" />
        <path d="M20 4v4h-4" />
      </>
    )
  }
  {
    nome === 'coracao' && (
      <path d="M12 20s-7.5-4.7-7.5-9.7A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5-7.5 9.7-7.5 9.7Z" />
    )
  }
  {
    nome === 'equilibrio' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 3.5a4.25 4.25 0 0 0 0 8.5 4.25 4.25 0 0 1 0 8.5" />
      </>
    )
  }
  {
    nome === 'maos' && (
      <>
        <path d="M7 13.5 4.5 11a2 2 0 0 1 2.8-2.8L12 12.7l4.7-4.5A2 2 0 0 1 19.5 11L17 13.5" />
        <path d="M7 13.5c1.7 3 3.4 4.5 5 4.5s3.3-1.5 5-4.5" />
      </>
    )
  }
  {
    nome === 'grupo' && (
      <>
        <circle cx="9" cy="9" r="3" />
        <circle cx="17" cy="10.5" r="2.2" />
        <path d="M3.5 19c.6-2.8 2.7-4.3 5.5-4.3s4.9 1.5 5.5 4.3" />
        <path d="M16 14.9c2.1.2 3.6 1.5 4.1 3.6" />
      </>
    )
  }
</svg>
