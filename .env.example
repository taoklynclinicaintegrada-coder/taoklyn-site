# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Endereco publico final do site (usado em canonical, sitemap e Open Graph).
# Enquanto o dominio oficial nao for definido, vale o endereco do Cloudflare Pages.
SITE_URL="https://taoklyn-site.pages.dev"

# Google Analytics 4 (opcional). Sem esta variavel o site funciona normalmente,
# apenas sem medicao. Formato: G-XXXXXXXXXX
PUBLIC_GA_ID=""
